{
  "name": "flowsight-mobile",
  "version": "1.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "PATH=\"$HOME/.local/share/mise/installs/ruby/3.3.12/bin:$HOME/.local/node/bin:$PATH\" LANG=en_US.UTF-8 expo run:ios --device",
    "prebuild:ios": "PATH=\"$HOME/.local/share/mise/installs/ruby/3.3.12/bin:$HOME/.local/node/bin:$PATH\" LANG=en_US.UTF-8 expo prebuild -p ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "2.112.4",
    "expo": "~53.0.0",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "flowsight-device-activity": "file:./modules/flowsight-device-activity",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "babel-preset-expo": "~13.0.0",
    "eas-cli": "^16.28.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
