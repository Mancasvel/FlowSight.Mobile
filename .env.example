# FlowSight Mobile Configuration
# Copy to .env.local and fill in values.
# Only EXPO_PUBLIC_* variables are included in the bundle.

# Supabase (public identifiers only — no secrets)
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Keep false in 1.4.0 production builds until the coordinated v6 rollout.
EXPO_PUBLIC_PRIVATE_SYNC_ENABLED=false
